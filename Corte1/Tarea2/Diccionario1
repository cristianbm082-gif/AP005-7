y muffin\": 2}  # --> Crea un diccionario llamado menu\n","print(\"Before: \", menu)  # --> Imprime el diccionario original\n","menu[\"cheesecake\"] = 8  # --> Agrega una nueva clave al diccionario llamada cheesecake con el valor de 8\n","print(\"After\", menu)  # --> Imprime el diccionario con las modificaciones\n","\n","animals_in_zoo = {\"dinosaurs\": 0}  # --> Crea el diccionario animals_in_zoo\n","animals_in_zoo = {\"dinosaurs\": 0}  # --> Reemplaza el diccionario anterior por el mismo\n","animals_in_zoo = {\"horses\": 2}  # --> Vuelve a reemplazar el diccionario por uno nuevo\n","print(animals_in_zoo)  # --> Imprime horses\n","\n","\n","## Add multiple keys\n","\n","sensors = {\"living room\": 21, \"kitchen\": 23, \"bedroom\": 20}  # --> Crea el diccionario sensors con sus claves y sus valores\n","print(\"Before\", sensors)  # --> Imprime el diccionario original\n","\n","# If we wanted to add 3 new rooms, we could use:\n","sensors.update({\"pantry\": 22, \"guest room\": 25, \"patio\": 34})  # --> Usa el método .update para agregar 3 claves con sus valores al diccionario\n","print(\"After\", sensors)  # --> Imprime el diccionario modificado\n","\n","\n","user_ids = {\"teraCoder\": 9018293, \"proProgrammer\": 119238}  # --> Crea un diccionario llamado user_ids\n","print(user_ids)  # --> Imprime el diccionario\n","user_ids.update({\"theLooper\": 138475, \"stringQueen\": 85739})  # --> Usa .update para agregarle dos nuevas claves con sus valores al diccionario\n","print(user_ids)  # --> Imprime el diccionario actualizado\n","\n","\n","## Overwrite Values\n","\n","# We know that we can add a key by using the following syntax:\n","menu[\"banana\"] = 3  # --> Verifica si banana existe en menu con el valor 3; si no existe, la agrega con el valor 3, pero si ya existe, reemplaza el valor que tenga por 3\n","\n","menu = {\"oatmeal\": 3, \"avocado toast\": 6, \"carrot juice\": 5, \"blueberry muffin\": 2}  # --> Crea el diccionario menu\n","print(\"Before: \", menu)  # --> Imprime el diccionario menu original\n","menu[\"oatmeal\"] = 5  # --> Reemplaza el valor anterior de oatmeal (3) por 5\n","print(\"After\", menu)  # --> Imprime el menu con las actualizaciones\n","\n","\n","## Notice the value of \"oatmeal\" has now changed to 5.\n","\n","oscar_winners = {\"Best Picture\": \"La La Land\", \"Best Actor\": \"Casey Affleck\", \"Best Actress\": \"Emma Stone\", \"Animated Feature\": \"Zootopia\"}  # --> Crea un diccionario llamado oscar_winners\n","print(\"Before\", oscar_winners)  # --> Imprime el diccionario original\n","print()  # --> Imprime una línea vacía\n","\n","oscar_winners.update({\"Supporting Actress\": \"Viola Davis\"})  # --> Usa .update para agregar una nueva clave con su valor\n","print(\"After1\", oscar_winners)  # --> Imprime el diccionario con su primera modificación\n","print()  # --> Crea una línea vacía\n","\n","oscar_winners[\"Best Picture\"] = \"Moonlight\"  # --> Modifica por segunda vez el diccionario\n","print(\"After2\", oscar_winners)  # --> Imprime el diccionario con su segunda modificación\n","\n","\n","## Dict Comprehensions\n","\n","# Let's say we have two lists that we want to combine into a\n","# dictionary, like a list of students and a list of their heights,\n","# in inches:\n","\n","names = ['Jenny', 'Alexus', 'Sam', 'Grace']  # --> Crea una lista llamada names con 4 nombres\n","heights = [61, 70, 67, 64]  # --> Crea otra lista llamada heights con 4 alturas en pulgadas\n","\n","# Python allows you to create a dictionary using\n","# a dict comprehension, with this syntax:\n","\n","zipStudents = zip(names, heights)  # --> Combina las listas names y heights emparejando sus elementos en un objeto zip\n","print(\"zipStudents: \", zipStudents)  # --> Imprime la referencia en memoria del objeto zip (zipStudents)\n","\n","students = {key:value for key, value in zip(names, heights)}  # --> Usa una comprensión de diccionario para convertir el zip de nombres y alturas en un diccionario clave:valor\n","# students is now {'Jenny': 61, 'Alexus': 70, 'Sam': 67, 'Grace': 64}  # --> Muestra cómo queda el diccionario emparejado\n","print(students)  # --> Imprime el diccionario de estudiantes con sus respectivas alturas\n","\n","# zip() combines two lists into an iterator of tuples with the list elements paired together. This dict comprehension:\n","\n","drinks = [\"espresso\", \"chai\", \"decaf\", \"drip\"]  # --> Crea una lista con nombres de bebidas\n","caffeine = [64, 40, 0, 120]  # --> Crea una lista con los miligramos de cafeína de cada bebida\n","\n","zipped_drinks = zip(drinks, caffeine)  # --> Empareja la lista de bebidas con la lista de cafeína usando zip()\n","print(zipped_drinks)  # --> Imprime la referencia en memoria del objeto zip creado\n","\n","drinks_to_caffeine = {key:value for key, value in zipped_drinks}  # --> Construye un diccionario clave:valor relacionando cada bebida con su nivel de cafeína mediante comprensión de diccionario\n","print(drinks_to_caffeine)  # --> Imprime el diccionario drinks_to_caffeine resultante\n","\n","\n","songs = [\"Like a Rolling Stone\", \"Satisfaction\", \"Imagine\", \"What's Going On\", \"Respect\", \"Good Vibrations\"]  # --> Crea una lista llamada songs con títulos de canciones\n","playcounts = [78, 29, 44, 21, 89, 5]  # --> Crea una lista llamada playcounts con el número de reproducciones de cada canción\n","\n","plays = {key:value for key, value in zip(songs, playcounts)}  # --> Crea un diccionario llamado plays combinando las canciones (claves) con sus reproducciones (valores) mediante comprensión de diccionario\n","print(plays)  # --> Imprime el diccionario plays original\n","\n","plays.update({\"Purple Haze\": 1})  # --> Agrega la nueva canción \"Purple Haze\" con 1 reproducción al diccionario plays usando .update()\n","plays.update({\"Respect\": 94})  # --> Actualiza el número de reproducciones de la canción existente \"Respect\" a 94 usando .update()\n","\n","print(\"After: \", plays)  # --> Imprime el diccionario pla